{
	"meta": {
		"title": "Test Document (v0.0.5)",
		"_comment": "v0.0.5 adds: styles and multiparagraphs"
	},

	"template": {
		"_comment": "used only to direct newly created elements (or rebuild e.g. index)",
		"page": {
		},
		"toc": true,
		"tocFormat": "default",
		"index": true,
		"indexFormat": "default"
	},

	"maps": {
		"_comment": "kinda like shortcuts to common/complex items, like images and fonts",
		"fonts": {
			"main": {
				"src": "src/Tangerine-Regular.ttf",
				"_about": "https://fonts.google.com/specimen/Tangerine",
				"_comment": "https://fonts.google.com/download?family=Tangerine"
			}
		},
		"images": {
			"main-logo": {
				"src": "src/jzin.png",
				"size": [512, 185]
			}
		},
		"styles": {
			"_DEFAULT_": {
				"font": "main"
			},
			"big-red": {
				"_comment": "anything not set here, inherits from default",
				"color": "red",
				"fontSize": 100
			}
		}
	},

	"document": {
		"_comment": "what will actually be turned into pdf pages",

		"layout": {
			"paperSize": [100, 200],
			"up": "2x2",
			"duplex": "long"
		},

		"pages": [

			{
				"size": [0, 0, 396, 612],
				"elements": [

					{
						"elementType": "text",
						"position": [36, 36],
						"font": "main",
						"fontSize": 30,
						"_align": "left",
						"text": "Hello world."
					},

					{
						"elementType": "text",
						"position": [200, 36],
						"style": "big-red",
						"_align": "left",
						"text": "Big?"
					},


					{
						"elementType": "text",
						"textType": "multi",
						"position": [36, 160],
						"text": [
							{
								"text": "Hello",
								"color": "blue"
							},
							{
								"text": " World!",
								"color": "red",
								"fontSize": 9
							},
							{
								"text": " and this is the rest of the text for us to show in this paragraph",
								"fontSize": 21
							}
						]
					},

					{
						"elementType": "image",
						"image": "main-logo",
						"position": [36, 120],
						"width": 128,
						"height": 46.25
					}

				]
			}
		]
	}
}

